# ─────────────────────────────────────────────────────────────
#  안전지도(가칭) — 환경변수 예시
#  실제 값은 .env.local 에 넣으세요. (.env.local 은 git 에 올리지 않습니다)
#  값은 Supabase 대시보드 > Project Settings > API 에서 확인합니다.
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon(public) 키 — 브라우저에 노출되어도 되는 공개 키
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 서비스가 동작하는 기본 URL (이메일 인증 콜백 등에 사용)
# 로컬: http://localhost:3000 / 운영: https://your-domain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (선택) 서버 전용 service-role 키 — 절대 클라이언트에 노출 금지.
# 관리 작업/배치에서만 사용. 현재 골격에서는 사용하지 않으므로 비워둬도 됩니다.
# SUPABASE_SERVICE_ROLE_KEY=""

# (선택) Anthropic API 키 — AI '위험요인 예시' 기능에 사용.
# 없으면 AI 예시 기능이 자동으로 꺼지고 수동 입력만 동작합니다(앱은 정상).
# ANTHROPIC_API_KEY=""

# (선택) USD→KRW 환율. 미설정 시 기본값(1400) 사용. AI 원가(KRW) 환산에만 쓰임.
# USD_TO_KRW="1400"

# ── 일정 알림(크론·이메일) ─────────────────────────────────────
# (선택) 크론 보호용 시크릿. 설정 시 /api/cron/* 는 Authorization: Bearer <값> 필요.
#   Vercel Cron 은 CRON_SECRET 설정 시 자동으로 헤더를 첨부합니다.
# CRON_SECRET=""

# (선택) 전 워크스페이스 스캔용 service-role 키 (RLS 우회). 크론에서만 사용.
# SUPABASE_SERVICE_ROLE_KEY=""

# (선택) 이메일 발송(Resend). 둘 다 있어야 이메일 알림이 동작합니다(없으면 인앱만).
# RESEND_API_KEY=""
# EMAIL_FROM="안전지도 <noreply@your-domain.com>"

# ── 구독 결제(PortOne V2) ─────────────────────────────────────
# (선택) pro 월 구독가(원). 미설정 시 기본 49,000원. 가격은 cogs(AI 원가)로 마진 검증.
# NEXT_PUBLIC_PRO_PRICE_KRW="49000"

# (선택) PortOne 결제. API_SECRET·STORE_ID·CHANNEL_KEY 가 모두 있어야 결제가 켜집니다.
#   없으면 결제 버튼이 '준비중'으로 비활성화되고 앱은 정상 동작합니다.
#   정기결제 갱신(/api/cron/billing)·웹훅 처리에는 SUPABASE_SERVICE_ROLE_KEY 도 필요합니다.
# PORTONE_API_SECRET=""              # 서버 전용 (절대 노출 금지)
# PORTONE_STORE_ID=""                # 상점 ID
# PORTONE_CHANNEL_KEY=""             # 결제 채널 키 (빌링키 발급용)
# PORTONE_WEBHOOK_SECRET=""          # 웹훅 서명 검증 시크릿(whsec_…). /api/webhooks/portone
